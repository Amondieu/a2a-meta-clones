# a2a-meta-clones — example env vars
# Copy to .env and fill in. NEVER commit .env.
#
# Per-slot env vars (Railway Variables; one set per service):
# See services/slot-X/env.template and docs/env_contract.md for the full contract.

# === slot-a ===
# CLONE_A_ID=agent-lens
# CLONE_A_MANIFEST_PATH=clone_specs/agent-lens.json
# CLONE_A_CATEGORY=agent_devtools
# CLONE_A_GAP_NAME=...
# CLONE_A_REGULATORY_ANCHOR=...
# CLONE_A_PRICE_USD=0.05
# CLONE_B_ID=audit-bazaar
# CLONE_B_MANIFEST_PATH=clone_specs/audit-bazaar.json
# CLONE_B_CATEGORY=...
# ...

# === slot-b ===
# CLONE_A_ID=agent-fabric-oversight
# CLONE_A_MANIFEST_PATH=clone_specs/agent-fabric__human-oversight-integration.json
# CLONE_A_CATEGORY=...
# CLONE_B_ID=agent-ledger
# CLONE_B_MANIFEST_PATH=clone_specs/agent-ledger.json
# CLONE_B_CATEGORY=...
# ...

# === slot-c ===
# CLONE_A_ID=compliance-lens
# CLONE_A_MANIFEST_PATH=clone_specs/compliance-lens.json
# CLONE_A_CATEGORY=...
# ...

# Per-slot (set on each Railway service):
# ROOT_DIRECTORY=services/slot-a    # or slot-b / slot-c
# DEPLOYMENT_AT=2026-07-11T00:00:00Z  # set by CI

# CI-only (GitHub Actions secrets; never local):
# RAILWAY_TOKEN=...                   # set via `gh secret set RAILWAY_TOKEN`
